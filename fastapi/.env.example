# Copiar como fastapi/.env únicamente en el servidor de despliegue.
# No versionar secretos ni tokens reales.
DB_HOST=your-mysql-host
DB_USER=your-db-user
DB_PASS=replace-me
DB_NAME=SISTEMAGEST
HF_AUTH_TOKEN=replace-me

# Inferencia: iniciar con un worker CPU. Escalar workers solo después de medir
# memoria y CPU, pues cada uno carga sus propios modelos (ASR + alineador + diarizador).
DEVICE=cpu
MODEL_SIZE=medium
COMPUTE_TYPE=int8
ASR_THREADS=4
ASR_BEAM_SIZE=5
SPEECH_WORKER_CONCURRENCY=1
MAX_AUDIO_FILES_PER_JOB=250
MAX_UNCOMPRESSED_BYTES=4294967296
